{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "maxkit://contracts/point_lot.schema.json",
  "title": "PointLot",
  "description": "One grant of points. source is provenance only. Balances are never split into paid and free buckets. Spendable points are remaining minus reserved, ignoring expired unreserved points.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "owner_id",
    "owner_kind",
    "source",
    "original_amount",
    "remaining",
    "reserved",
    "expires_at",
    "created_at",
    "ref",
    "idempotency_key"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "owner_id": { "type": "string", "minLength": 1 },
    "owner_kind": { "enum": ["person", "org"] },
    "source": { "enum": ["grant", "purchase", "promo", "adjust"] },
    "original_amount": { "type": "integer", "minimum": 1 },
    "remaining": { "type": "integer", "minimum": 0 },
    "reserved": { "type": "integer", "minimum": 0 },
    "expires_at": { "type": ["string", "null"], "format": "date-time" },
    "created_at": { "type": "string", "format": "date-time" },
    "ref": { "type": ["string", "null"], "minLength": 1 },
    "idempotency_key": { "type": "string", "minLength": 1 }
  }
}
