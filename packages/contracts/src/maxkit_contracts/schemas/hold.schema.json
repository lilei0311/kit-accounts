{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "maxkit://contracts/hold.schema.json",
  "title": "Hold",
  "description": "A reservation against lot remaining. open holds reduce available points. settle consumes them. release returns them unless the lot has already expired.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "owner_id",
    "owner_kind",
    "amount",
    "status",
    "allocations",
    "ref",
    "idempotency_key",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "owner_id": { "type": "string", "minLength": 1 },
    "owner_kind": { "enum": ["person", "org"] },
    "amount": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["open", "settled", "released"] },
    "allocations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lot_id", "amount"],
        "properties": {
          "lot_id": { "type": "string", "minLength": 1 },
          "amount": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "ref": { "type": ["string", "null"], "minLength": 1 },
    "idempotency_key": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
